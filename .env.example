# Copy this file to .env and fill it in. .env is git-ignored: never commit it,
# never paste a key in a chat, an issue or a notebook.
# Nothing here is needed to run the tests or the CI.

# Google AI Studio key (agent model). Create and restrict it at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hard stop for the theoretical cumulated LLM cost of one run, in USD
OABENCH_MAX_COST_USD=1.00
