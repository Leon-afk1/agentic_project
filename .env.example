# Copy to .env and fill in. Never commit .env.
# Nothing here is needed to run the tests or the CI.

# Agent model (needed from the agent milestone onwards)
MISTRAL_API_KEY=

# Judge model (full version only)
GEMINI_API_KEY=

# Hard stop for the theoretical cumulated LLM cost of one run, in USD
OABENCH_MAX_COST_USD=1.00
